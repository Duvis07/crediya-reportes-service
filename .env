# Database Configuration (not used in reportes-service, but keeping for consistency)
R2DBC_HOST=localhost
R2DBC_PORT=5433
R2DBC_DATABASE=crediya_reportes_db
R2DBC_USERNAME=postgres
R2DBC_PASSWORD=nueva_password

# Authentication Service Configuration (for future integrations)
AUTH_SERVICE_BASE_URL=http://localhost:8080
AUTH_SERVICE_ENDPOINTS_API_BASE=/api/v1/usuarios
AUTH_SERVICE_ENDPOINTS_USER_BY_DOCUMENT=/{documentId}

# JWT Configuration (for future authentication)
JWT_JWK_SET_URI=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER_URI=http://localhost:8080
JWT_SECRET=mySecretKeyForCrediyaAuthenticationServiceThatIsLongEnoughForHS256
JWT_EXPIRATION=86400

# AWS LocalStack Configuration (usando LocalStack compartido de solicitudes)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB Configuration
DYNAMODB_TABLE_LOAN_REPORTS=loan-reports

# SQS Configuration
AWS_SQS_QUEUES_LOAN_APPROVED_EVENTS=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/loan-approved-events-queue

# MailHog Configuration (para emails locales)
MAILHOG_SMTP_HOST=localhost
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_URL=http://localhost:8025

# Email Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=reportes@crediya.com

# Admin Email Configuration
ADMIN_EMAILS=admin@crediya.com,gerente@crediya.com,director@crediya.com

# Scheduler Configuration - 8:00 PM daily
DAILY_REPORT_CRON=0 0 20 * * *

# Spring Configuration
SPRING_PROFILES_ACTIVE=local

# Server Configuration
SERVER_PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
